{
  "name": "pilot",
  "split": "dev",
  "scenario_file": "experiments/pilot/scenarios.json",
  "max_steps": 50,
  "output_char_limit": 8000,
  "appworld_timeout_seconds": 100,
  "max_usd_per_invocation": 3.0,
  "ledger_caps_usd": {
    "nebius.com": 5.0
  },
  "notes": [
    "max_steps 50, temperature 0 and seed 123 are the defaults of AppWorld's minimal ReAct agent (notebooks/minimal_agent.ipynb).",
    "max_tokens is 1500 instead of that notebook's 400 so that models that think before answering are not cut off.",
    "Prices are US dollars per million tokens, read from the provider's model list on 2026-11-19. Re-read them before a new batch.",
    "Which entry plays 'small' and which plays 'cloud' in a given run is chosen on the command line and recorded in each run's meta file."
  ],
  "models": {
    "qwen3-8b-local": {
      "role": "small",
      "name": "qwen3-8b",
      "base_url": "http://127.0.0.1:8081/v1",
      "usd_per_mtok_in": 0.0,
      "usd_per_mtok_out": 0.0,
      "context_budget_tokens": 28000,
      "extra_body": {"chat_template_kwargs": {"enable_thinking": false}}
    },
    "qwen3-30b-a3b": {
      "role": "small",
      "name": "Qwen/Qwen3-30B-A3B-Instruct-2507",
      "base_url": "https://api.tokenfactory.nebius.com/v1",
      "api_key_env": "NEBIUS_API_KEY",
      "usd_per_mtok_in": 0.10,
      "usd_per_mtok_out": 0.30,
      "context_budget_tokens": 200000
    },
    "gemma-3-27b": {
      "role": "small",
      "name": "google/gemma-3-27b-it",
      "base_url": "https://api.tokenfactory.nebius.com/v1",
      "api_key_env": "NEBIUS_API_KEY",
      "usd_per_mtok_in": 0.10,
      "usd_per_mtok_out": 0.30,
      "context_budget_tokens": 90000
    },
    "gpt-oss-120b": {
      "role": "small",
